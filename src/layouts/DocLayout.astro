            /* Mermaid Container & Toolbar */
            .mermaid-container {
                position: relative;
                padding: 1rem 0;
                margin: 1.5rem auto;
                overflow-x: auto;
                max-width: 100%;
                cursor: pointer;
                display: flex;
                flex-direction: column;
