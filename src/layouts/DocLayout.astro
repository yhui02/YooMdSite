                opacity: 0;
                transition: opacity 0.15s ease;
                z-index: 5;
            }
            .mermaid-container:hover .mermaid-toolbar {
                opacity: 1;
            }
            .mermaid-btn {
                display: inline-flex;
                align-items: center;
                gap: 0.375rem;
                padding: 0.375rem 0.75rem;
                font-size: 0.75rem;
                color: #6b7280;
                background: #fff;
                border: 1px solid #d1d5db;
                border-radius: 0.375rem;
                cursor: pointer;
                transition: all 0.15s ease;
            }
            .mermaid-btn:hover {
                background: #f3f4f6;
                color: #374151;
                border-color: #9ca3af;
            }
            .mermaid-btn svg {
                width: 14px;
                height: 14px;
            }

            /* Lightbox Modal */
            .mermaid-modal {
                display: none;
                position: fixed;
                inset: 0;
                z-index: 9999;
                background: rgba(0, 0, 0, 0.9);
                justify-content: center;
                align-items: center;
                cursor: zoom-out;
            }
            .mermaid-modal.open {
                display: flex;
            }
            .mermaid-modal-content {
                background: #fff;
                width: 100vw;
                height: 100vh;
                overflow: auto;
                cursor: default;
                display: flex;
                justify-content: center;
                align-items: center;
            }
            .mermaid-modal-content svg {
                max-width: 90vw;
                max-height: 90vh;
                width: auto;
                height: auto;
                display: block;
                transition: transform 0.15s ease;
                transform-origin: center center;
            }
            .mermaid-modal-close {
                position: fixed;
                top: 1rem;
                right: 1rem;
                width: 2rem;
                height: 2rem;
                border-radius: 50%;
                background: rgba(0, 0, 0, 0.6);
                border: none;
                color: #fff;
                line-height: 0;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: background 0.15s ease;
                z-index: 10000;
                padding: 0;
                margin: 0;
            }
            .mermaid-modal-close svg {
                width: 12px;
                height: 12px;
                display: block;
            }
            .mermaid-modal-close:hover {
                background: rgba(0, 0, 0, 0.8);
            }

            /* Priority badges in tables */
            .priority-badge {
                display: inline-block;
                padding: 2px 8px;
                border-radius: 9999px;
                font-size: 12px;
                font-weight: 600;
                line-height: 1.4;
                text-align: center;
                white-space: nowrap;
            }
            .priority-badge.p0 {
                background: #fef2f2;
                color: #dc2626;
                border: 1px solid #fecaca;
            }
            .priority-badge.p1 {
                background: #fffbeb;
                color: #d97706;
                border: 1px solid #fde68a;
            }
            .priority-badge.p2 {
                background: #f0fdf4;
                color: #16a34a;
                border: 1px solid #bbf7d0;
            }
            html.dark .priority-badge.p0 {
                background: #450a0a;
                color: #fca5a5;
                border-color: #7f1d1d;
            }
            html.dark .priority-badge.p1 {
                background: #451a03;
                color: #fcd34d;
                border-color: #92400e;
            }
            html.dark .priority-badge.p2 {
                background: #052e16;
                color: #86efac;
                border-color: #166534;
            }

            /* Mobile Responsive Styles */
            .mobile-menu-btn {
                display: none;
            }
            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.5);
                z-index: 40;
                opacity: 0;
                transition: opacity 0.3s ease;
            }
            .sidebar-overlay.active {
                display: block;
                opacity: 1;
            }

            @media (max-width: 768px) {
                .mobile-menu-btn {
                    display: flex;
                }
                .desktop-nav {
                    display: none;
                }
                aside {
                    position: fixed !important;
                    left: -280px !important;
                    top: 0;
                    bottom: 0;
                    width: 280px;
                    z-index: 50;
                    transition: left 0.3s ease;
                    box-shadow: none;
                    margin-top: 0 !important;
                    height: 100vh !important;
                    top: 0 !important;
                }
                aside.open {
                    left: 0 !important;
                    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
                }
                .main-content-wrapper {
                    padding-left: 0 !important;
                    padding-right: 0 !important;
                }
                .article-content-area {
                    padding: 16px !important;
                }
                .header-container {
                    padding-left: 16px !important;
                    padding-right: 16px !important;
                }
                .project-description {
                    display: none;
                }
            }

            @media (max-width: 480px) {
                .header-project-name {
                    font-size: 14px !important;
                }
                .article-content-area {
                    padding: 12px !important;
                }
                article h1 {
                    font-size: 1.25rem !important;
                }
                article h2 {
                    font-size: 1.125rem !important;
                }
                article h3 {
                    font-size: 1rem !important;
                }
            }

            /* Settings Modal */
            .settings-modal {
                display: none;
                position: fixed;
                inset: 0;
                z-index: 9998;
                background: rgba(0, 0, 0, 0.5);
                justify-content: center;
                align-items: center;
            }
            .settings-modal.open {
                display: flex;
            }
            .settings-modal-content {
                background: #fff;
                border-radius: 12px;
                width: 90%;
                max-width: 520px;
                max-height: 80vh;
                overflow-y: auto;
                box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            }
            .settings-modal-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 16px 20px;
                border-bottom: 1px solid #e5e7eb;
            }
            .settings-modal-header h2 {
                font-size: 16px;
                font-weight: 600;
                color: #111827;
                margin: 0;
            }
            .settings-modal-close {
                width: 28px;
                height: 28px;
                border-radius: 6px;
                border: none;
                background: transparent;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #6b7280;
            }
            .settings-modal-close:hover {
                background: #f3f4f6;
            }
            .settings-modal-body {
                padding: 16px 20px;
            }
            .settings-path-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px;
                border: 1px solid #e5e7eb;
                border-radius: 8px;
                margin-bottom: 8px;
                transition: all 0.15s ease;
            }
            .settings-path-item.is-default {
                border-color: #a5b4fc;
                background: #eef2ff;
            }
            /* 路径不存在时的样式 */
            .settings-path-item.path-missing {
                border-color: #fca5a5;
                background: #fef2f2;
            }
            .settings-path-item.path-missing .settings-path-name {
                color: #dc2626;
            }
            .settings-path-item.path-missing .settings-path-dir {
                color: #b91c1c;
            }
            .path-missing-text {
                color: #dc2626 !important;
                text-decoration: line-through;
            }
            .settings-path-info {
                flex: 1;
                min-width: 0;
            }
            .settings-path-name {
                font-size: 14px;
                font-weight: 500;
                color: #111827;
            }
            .settings-path-dir {
                font-size: 12px;
                color: #6b7280;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                margin-top: 2px;
            }
            .settings-path-actions {
                display: flex;
                gap: 2px;
                flex-shrink: 0;
            }
            .settings-path-actions button {
                padding: 4px 8px;
                font-size: 12px;
                border-radius: 4px;
                border: none;
                cursor: pointer;
                transition: all 0.15s ease;
            }
            .settings-btn-default {
                color: #4f46e5;
                background: transparent;
            }
            .settings-btn-default:hover {
                background: #eef2ff;
            }
            .settings-btn-edit {
                color: #6b7280;
                background: transparent;
            }
            .settings-btn-edit:hover {
                background: #f3f4f6;
            }
            .settings-btn-delete {
                color: #ef4444;
                background: transparent;
            }
            .settings-btn-delete:hover {
                background: #fef2f2;
            }
            .settings-btn-copy {
                color: #059669;
                background: transparent;
            }
            .settings-btn-copy:hover {
                background: #ecfdf5;
            }
            .settings-badge {
                font-size: 11px;
                background: #eef2ff;
                color: #4f46e5;
                padding: 1px 8px;
                border-radius: 9999px;
                margin-left: 6px;
            }
            /* 默认文档标签 - 更醒目的样式 */
            .settings-badge-default {
                font-size: 11px;
                background: linear-gradient(135deg, #4f46e5, #7c3aed);
                color: #ffffff;
                padding: 2px 10px;
                border-radius: 9999px;
                margin-left: 6px;
                font-weight: 600;
                box-shadow: 0 1px 3px rgba(79, 70, 229, 0.3);
            }
            .settings-add-btn {
                width: 100%;
                padding: 10px;
                border: 2px dashed #d1d5db;
                border-radius: 8px;
                background: transparent;
                color: #6b7280;
                font-size: 13px;
                cursor: pointer;
                transition: all 0.15s ease;
                margin-top: 4px;
            }
            .settings-add-btn:hover {
                border-color: #818cf8;
                color: #4f46e5;
            }
            .settings-form {
                margin-top: 12px;
                padding: 12px;
                border: 1px solid #e5e7eb;
                border-radius: 8px;
                background: #f9fafb;
            }
            .settings-form h3 {
                font-size: 14px;
                font-weight: 600;
                color: #374151;
                margin: 0 0 10px 0;
            }
            .settings-form label {
                display: block;
                font-size: 12px;
                font-weight: 500;
                color: #374151;
                margin-bottom: 4px;
            }
            .settings-form input {
                width: 100%;
                padding: 6px 10px;
                border: 1px solid #d1d5db;
                border-radius: 6px;
                font-size: 13px;
                margin-bottom: 8px;
                box-sizing: border-box;
            }
            .settings-form input:focus {
                outline: none;
                border-color: #818cf8;
                box-shadow: 0 0 0 2px rgba(129, 140, 248, 0.2);
            }
            .settings-form-actions {
                display: flex;
                justify-content: flex-end;
                gap: 6px;
                margin-top: 4px;
            }
            .settings-form-actions button {
                padding: 6px 14px;
                font-size: 13px;
                border-radius: 6px;
                border: none;
                cursor: pointer;
            }
            .settings-form-cancel {
                background: #f3f4f6;
                color: #374151;
            }
            .settings-form-cancel:hover {
                background: #e5e7eb;
            }
            .settings-form-save {
                background: #4f46e5;
                color: #fff;
            }
            .settings-form-save:hover {
                background: #4338ca;
            }
            .settings-error {
                font-size: 12px;
                color: #ef4444;
                margin-top: 4px;
            }
            .settings-ssr-notice {
                background: #fffbeb;
                border: 1px solid #fde68a;
                border-radius: 8px;
                padding: 12px;
                font-size: 13px;
                color: #92400e;
                margin-bottom: 12px;
            }
            .settings-ssr-notice code {
                background: #fef3c7;
                padding: 1px 6px;
                border-radius: 4px;
                font-size: 12px;
            }

            /* Dark mode settings modal */
            html.dark .settings-modal-content {
                background: #1f2937;
            }
            html.dark .settings-modal-header {
                border-color: #374151;
            }
            html.dark .settings-modal-header h2 {
                color: #f3f4f6;
            }
            html.dark .settings-modal-close {
                color: #9ca3af;
            }
            html.dark .settings-modal-close:hover {
                background: #374151;
            }
            html.dark .settings-path-item {
                border-color: #374151;
                background: #111827;
            }
            html.dark .settings-path-item.is-default {
                border-color: #4f46e5;
                background: #312e81;
            }
            /* 暗色模式下路径不存在 */
            html.dark .settings-path-item.path-missing {
                border-color: #7f1d1d;
                background: #450a0a;
            }
            html.dark .settings-path-item.path-missing .settings-path-name {
                color: #fca5a5;
            }
            html.dark .settings-path-item.path-missing .settings-path-dir {
                color: #f87171;
            }
            html.dark .path-missing-text {
                color: #f87171 !important;
            }
            html.dark .settings-path-name {
                color: #f3f4f6;
            }
            html.dark .settings-path-dir {
                color: #9ca3af;
            }
            html.dark .settings-badge {
                background: #312e81;
                color: #a5b4fc;
            }
            /* 暗色模式下默认文档标签 */
            html.dark .settings-badge-default {
                background: linear-gradient(135deg, #6366f1, #8b5cf6);
                color: #ffffff;
                box-shadow: 0 1px 3px rgba(99, 102, 241, 0.4);
            }
            html.dark .settings-add-btn {
                border-color: #4b5563;
                color: #9ca3af;
            }
            html.dark .settings-add-btn:hover {
                border-color: #818cf8;
                color: #a5b4fc;
            }
            html.dark .settings-form {
                background: #111827;
                border-color: #374151;
            }
            html.dark .settings-form h3 {
                color: #f3f4f6;
            }
            html.dark .settings-form label {
                color: #d1d5db;
            }
            html.dark .settings-form input {
                background: #1f2937;
                border-color: #4b5563;
                color: #f3f4f6;
            }
            html.dark .settings-form-cancel {
                background: #374151;
                color: #d1d5db;
            }
            html.dark .settings-form-cancel:hover {
                background: #4b5563;
            }
            html.dark .settings-ssr-notice {
                background: #451a03;
                border-color: #92400e;
                color: #fcd34d;
            }
            html.dark .settings-ssr-notice code {
                background: #78350f;
                color: #fde68a;
            }
        </style>
    </head>
    <body class="bg-white text-gray-800 antialiased">
        <!-- Header -->
        <header
            class="bg-white/80 backdrop-blur-md border-b border-gray-200 no-print fixed top-0 left-0 right-0 z-50"
        >
            <div
                class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between header-container"
            >
                <div class="flex items-center gap-3">
                    <!-- 移动端汉堡菜单按钮 -->
                    <button
                        id="mobileMenuBtn"
                        class="mobile-menu-btn w-10 h-10 flex items-center justify-center rounded-lg hover:bg-gray-100 transition-colors md:hidden"
                        title="打开导航菜单"
                    >
                        <svg
                            class="w-5 h-5 text-gray-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"
                            ></path>
                        </svg>
                    </button>
                    <a
                        href={withBase("/")}
                        class="flex items-center gap-3 cursor-pointer group"
                        title="返回首页"
                    >
                        <!-- Markdown logo -->
                        <div class="w-8 h-8">
                            <svg class="w-8 h-8" viewBox="0 0 1024 1024">
                                <circle cx="512" cy="512" r="512" fill="#FF4D4F"
                                ></circle>
                                <path
                                    d="M533.333333 682.666667c-8.533333 0-12.8-4.266667-17.066666-12.8l-170.666667-298.666667c-8.533333-8.533333-4.266667-21.333333 8.533333-25.6 8.533333-8.533333 21.333333-4.266667 25.6 8.533333l170.666667 298.666667c4.266667 8.533333 4.266667 21.333333-8.533333 29.866667h-8.533334z"
                                    fill="#FFFFFF"></path>
                                <path
                                    d="M362.666667 725.333333c-12.8 0-21.333333-8.533333-21.333334-21.333333v-341.333333c0-12.8 8.533333-21.333333 21.333334-21.333334s21.333333 8.533333 21.333333 21.333334v341.333333c0 12.8-8.533333 21.333333-21.333333 21.333333zM704 725.333333c-12.8 0-21.333333-8.533333-21.333333-21.333333v-341.333333c0-12.8 8.533333-21.333333 21.333333-21.333334s21.333333 8.533333 21.333333 21.333334v341.333333c0 12.8-8.533333 21.333333-21.333333 21.333333z"
                                    fill="#FFFFFF"></path>
                                <path
                                    d="M533.333333 682.666667c-4.266667 0-8.533333 0-8.533333-4.266667-8.533333-4.266667-12.8-17.066667-8.533333-29.866667l170.666666-298.666666c4.266667-8.533333 17.066667-12.8 29.866667-8.533334 8.533333 4.266667 12.8 17.066667 8.533333 29.866667l-170.666666 298.666667c-8.533333 8.533333-12.8 12.8-21.333334 12.8z"
                                    fill="#FFFFFF"></path>
                            </svg>
                        </div>
                        <div>
                            <h1 class="text-base font-semibold text-gray-900 header-project-name">
                                {siteName}
                            </h1>
                            <p class="text-xs text-gray-400 mt-0.5 project-description">
                                {project.description || project.name}
                            </p>
                        </div>
                    </a>
                </div>
                <div class="flex items-center gap-2">
                    <button
                        id="settingsBtn"
                        class="w-8 h-8 flex items-center justify-center rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors"
                        title="系统设置"
                    >
                        <svg
                            class="w-4 h-4 text-gray-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                            ></path>
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                            ></path>
                        </svg>
                    </button>
                    <button
                        id="themeToggle"
                        class="w-8 h-8 flex items-center justify-center rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors"
                        title="切换暗色模式"
                    >
                        <svg
                            id="themeIconSun"
                            class="w-4 h-4 text-gray-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                            ></path>
                        </svg>
                        <svg
                            id="themeIconMoon"
                            class="w-4 h-4 text-gray-600 hidden"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                            ></path>
                        </svg>
                    </button>
                </div>
            </div>
        </header>

        <!-- Main Container -->
        <div class="max-w-6xl mx-auto pt-[75px]">
            <!-- 侧边栏遮罩(移动端) -->
            <div class="sidebar-overlay" id="sidebarOverlay"></div>

            <div class="flex bg-white min-h-screen main-content-wrapper">
                <!-- Sidebar -->
                {!hideSidebar && (
                <aside
                    class="w-64 bg-gray-50 border-r border-gray-200 no-print md:sticky sticky top-[75px] h-[calc(100vh-75px)] flex-shrink-0 flex flex-col"
                    id="mainSidebar"
                >
                    <!-- 切换按钮 -->
                    <div
                        class="nav-toggle-bar flex items-center justify-between px-4 h-10 border-b border-gray-200 flex-shrink-0"
                    >
                        <span class="text-xs font-medium text-gray-500"
                            >导航</span
                        >
                        <div class="flex gap-1 items-center">
                            <button
                                id="navTreeBtn"
                                class={`px-2 py-1 text-xs rounded ${tocMode === "tree" ? "bg-indigo-100 text-indigo-600" : "text-gray-400 hover:bg-gray-100"}`}
                            >
                                文档树
                            </button>
                            <button
                                id="navArticleBtn"
                                class={`px-2 py-1 text-xs rounded ${tocMode === "article" ? "bg-indigo-100 text-indigo-600" : "text-gray-400 hover:bg-gray-100"}`}
                            >
                                目录
                            </button>
                        </div>
                    </div>
                    <!-- 文档树导航 -->
                    <nav
                        id="sidebar-nav-tree"
                        class={`p-4 pt-2 space-y-0.5 flex-1 overflow-y-auto ${tocMode !== "tree" ? "hidden" : ""}`}
                        style="scroll-behavior: smooth;"
                    >
                        <div
                            set:html={docTree
                                .map((node) => renderTreeNode(node, 0))
                                .join("")}
                        />
                    </nav>
                    <!-- 文章目录 -->
                    <nav
                        id="sidebar-nav-article"
                        class={`p-4 pt-2 flex-1 overflow-y-auto ${tocMode !== "article" ? "hidden" : ""}`}
                        style="scroll-behavior: smooth;"
                    >
                        <div id="article-toc" class="space-y-1">
                            <!-- JS 动态生成 -->
                        </div>
                    </nav>
                </aside>
                )}
                <!-- Main Content -->
                <main class="flex-1 py-8 px-8 min-w-0 article-content-area">
                    <!-- 文档标题栏 -->
                    <div
                        class="flex items-center justify-between mb-6 pb-4 border-b border-gray-200"
                    >
                        <h1 class="text-xl font-semibold text-gray-900">
                            {title}
                        </h1>
                    </div>
                    <article id="article-content">
                        <slot />
                    </article>
                    {
                        lastModified && (
                            <div class="text-right text-sm text-gray-400 mt-6 pt-4 border-t border-gray-100">
                                最后更新时间：{lastModified}
                            </div>
                        )
                    }
                </main>
            </div>
        </div>

        <!-- Footer -->
        <footer class="bg-white border-t border-gray-200 py-4 no-print">
            <div
                class="max-w-6xl mx-auto px-6 flex items-center justify-between text-xs text-gray-400"
            >
                <span>{siteName}</span>
                <div class="flex gap-3">
                    <span>{totalDirs} 目录</span>
                    <span>·</span>
                    <span>{totalDocs} 文档</span>
                </div>
            </div>
        </footer>

        <!-- Mermaid Lightbox Modal -->
        <div class="mermaid-modal" id="mermaidModal">
            <div class="mermaid-modal-content" id="mermaidModalContent"></div>
        </div>

        <button
            class="mermaid-modal-close"
            id="mermaidModalClose"
            style="display:none"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>

        <!-- Settings Modal -->
        <div class="settings-modal" id="settingsModal">
            <div class="settings-modal-content">
                <div class="settings-modal-header">
                    <h2>文档路径管理</h2>
                    <button class="settings-modal-close" id="settingsModalClose">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <div class="settings-modal-body" id="settingsBody">
                    <div style="text-align:center;color:#9ca3af;font-size:13px;padding:24px 0;">加载中...</div>
                </div>
            </div>
        </div>

        <script>
            // ========== Mobile Menu Logic ==========
            const mobileMenuBtn = document.getElementById("mobileMenuBtn");
            const mainSidebar = document.getElementById("mainSidebar");
            const sidebarOverlay = document.getElementById("sidebarOverlay");

            function openMobileMenu() {
                mainSidebar?.classList.add("open");
                sidebarOverlay?.classList.add("active");
                document.body.style.overflow = "hidden";
            }

            function closeMobileMenu() {
                mainSidebar?.classList.remove("open");
                sidebarOverlay?.classList.remove("active");
                document.body.style.overflow = "";
            }

            mobileMenuBtn?.addEventListener("click", openMobileMenu);
            sidebarOverlay?.addEventListener("click", closeMobileMenu);

            // 点击侧边栏内的链接后关闭菜单(移动端)
            mainSidebar?.querySelectorAll(".sidebar-link").forEach((link) => {
                link.addEventListener("click", () => {
                    if (window.innerWidth < 768) {
                        closeMobileMenu();
                    }
                });
            });

            // 窗口大小变化时重置状态
            window.addEventListener("resize", () => {
                if (window.innerWidth >= 768) {
                    closeMobileMenu();
                    mainSidebar?.style.setProperty("left", "");
                }
            });

            // Dark mode toggle
            const themeToggle = document.getElementById("themeToggle");
            const iconSun = document.getElementById("themeIconSun");
            const iconMoon = document.getElementById("themeIconMoon");

            function setTheme(dark: boolean) {
                if (dark) {
                    document.documentElement.classList.add("dark");
                    iconSun?.classList.add("hidden");
                    iconMoon?.classList.remove("hidden");
                    localStorage.setItem("theme", "dark");
                } else {
                    document.documentElement.classList.remove("dark");
                    iconSun?.classList.remove("hidden");
                    iconMoon?.classList.add("hidden");
                    localStorage.setItem("theme", "light");
                }
                // Re-render mermaid with new theme
                reRenderMermaid(dark);
            }

            function reRenderMermaid(dark: boolean) {
                const containers =
                    document.querySelectorAll(".mermaid-container");
                if (containers.length === 0) return;

                // Simply toggle the CSS filter - much more reliable
                containers.forEach((container) => {
                    const contentDiv =
                        container.querySelector(".mermaid-content");
                    if (contentDiv) {
                        const svg = contentDiv.querySelector("svg");
                        if (svg) {
                            if (dark) {
                                svg.style.filter =
                                    "invert(1) hue-rotate(180deg)";
                            } else {
                                svg.style.filter = "";
                            }
                        }
                    }
                });
            }

            // Check saved preference or system preference
            const saved = localStorage.getItem("theme");
            if (
                saved === "dark" ||
                (!saved &&
                    window.matchMedia("(prefers-color-scheme: dark)").matches)
            ) {
                setTheme(true);
            }

            themeToggle?.addEventListener("click", () => {
                const isDark =
                    document.documentElement.classList.contains("dark");
                setTheme(!isDark);
            });

            let mermaidCounter = 0;

            // Wrap all .mermaid divs with toolbar (only after mermaid has rendered)
            function wrapMermaidDiagrams() {
                const mermaids = document.querySelectorAll("article .mermaid");
                mermaids.forEach((el) => {
                    // Skip if already wrapped or if mermaid hasn't rendered SVG yet
                    if (el.closest(".mermaid-container")) return;
                    const svg = el.querySelector("svg");
                    if (!svg) return;

                    // 甘特图特殊处理：通过 viewBox 判断是否是宽图表
                    const viewBox = svg.getAttribute("viewBox") || "";
                    const parts = viewBox.split(" ");
                    const svgWidth =
                        parts.length >= 4 ? parseFloat(parts[2]) : 0;
                    const isWideChart = svgWidth > 800;

                    if (isWideChart) {
                        // 宽图表：移除固定宽高，设置自适应
                        svg.removeAttribute("width");
                        svg.removeAttribute("height");
                        svg.style.width = "100%";
                        svg.style.maxWidth = "100%";
                        svg.style.height = "auto";
                        svg.style.display = "block";
                    }

                    mermaidCounter++;
                    const id = `mermaid-${mermaidCounter}`;
                    el.setAttribute("data-mermaid-id", id);

                    const container = document.createElement("div");
                    container.className = "mermaid-container";
                    container.dataset.mermaidId = id;
                    // 如果是宽图表，取消居中
                    if (isWideChart) {
                        container.style.alignItems = "flex-start";
                    }
                    // Save original graph content for theme switching
                    container.dataset.graph = el.textContent;

                    const toolbar = document.createElement("div");
                    toolbar.className = "mermaid-toolbar no-print";

                    const previewBtn = document.createElement("button");
                    previewBtn.className = "mermaid-btn";
                    previewBtn.dataset.action = "preview";
                    previewBtn.title = "点击查看大图";
                    previewBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`;

                    const downloadBtn = document.createElement("button");
                    downloadBtn.className = "mermaid-btn";
                    downloadBtn.dataset.action = "download";
                    downloadBtn.title = "下载 SVG 图片";
                    downloadBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>`;

                    toolbar.appendChild(previewBtn);
                    toolbar.appendChild(downloadBtn);

                    const wrapper = document.createElement("div");
                    wrapper.className = "mermaid-content";
                    while (el.firstChild) {
                        wrapper.appendChild(el.firstChild);
                    }

                    container.appendChild(toolbar);
                    container.appendChild(wrapper);
                    el.parentNode.insertBefore(container, el);
                    el.remove();
                });
            }

            // Open modal preview
            let currentScale = 1;

            function openModal(svgElement) {
                const modal = document.getElementById("mermaidModal");
                const content = document.getElementById("mermaidModalContent");
                content.innerHTML = "";
                const clone = svgElement.cloneNode(true);

                // Remove fixed dimensions so SVG fits within viewport
                clone.removeAttribute("width");
                clone.removeAttribute("height");
                clone.style.width = "auto";
                clone.style.height = "auto";
                clone.style.maxWidth = "90vw";
                clone.style.maxHeight = "90vh";
                clone.style.transform = "scale(1)";

                content.appendChild(clone);
                currentScale = 1;
                modal.classList.add("open");
                const closeBtn = document.getElementById("mermaidModalClose");
                if (closeBtn) closeBtn.style.display = "flex";
            }

            function closeModal() {
                const modal = document.getElementById("mermaidModal");
                modal.classList.remove("open");
                currentScale = 1;
                const closeBtn = document.getElementById("mermaidModalClose");
                if (closeBtn) closeBtn.style.display = "none";
            }

            // Download SVG
            function downloadSvg(svgElement, id) {
                const serializer = new XMLSerializer();
                let svgStr = serializer.serializeToString(svgElement);
                svgStr = `<?xml version="1.0" encoding="UTF-8"?>\n` + svgStr;

                const blob = new Blob([svgStr], {
                    type: "image/svg+xml;charset=utf-8",
                });
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = `${id}.svg`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }

            // Event delegation for toolbar buttons
            document.addEventListener("click", (e) => {
                const btn = e.target.closest(".mermaid-btn");
                if (!btn) return;

                const container = btn.closest(".mermaid-container");
                if (!container) return;

                const action = btn.dataset.action;
                const svgEl = container.querySelector(".mermaid-content svg");
                if (!svgEl) return;

                if (action === "preview") {
                    openModal(svgEl);
                } else if (action === "download") {
                    e.stopPropagation();
                    downloadSvg(
                        svgEl,
                        container.dataset.mermaidId || "mermaid-diagram",
                    );
                }
            });

            // Click on container (not buttons) to open preview
            document.addEventListener("click", (e) => {
                const container = e.target.closest(".mermaid-container");
                if (!container) return;
                if (e.target.closest(".mermaid-btn")) return;

                const svgEl = container.querySelector(".mermaid-content svg");
                if (svgEl) openModal(svgEl);
            });

            // Modal close handlers
            document
                .getElementById("mermaidModalClose")
                ?.addEventListener("click", (e) => {
                    e.stopPropagation();
                    closeModal();
                });

            document
                .getElementById("mermaidModal")
                ?.addEventListener("click", (e) => {
                    if (e.target === e.currentTarget) closeModal();
                });

            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") closeModal();
            });

            // Zoom with mouse wheel on modal content
            const modalContent = document.getElementById("mermaidModalContent");
            modalContent?.addEventListener(
                "wheel",
                (e) => {
                    e.preventDefault();
                    const svg = modalContent.querySelector("svg");
                    if (!svg) return;

                    if (e.deltaY < 0) {
                        currentScale = Math.min(currentScale + 0.15, 5);
                    } else {
                        currentScale = Math.max(currentScale - 0.15, 0.1);
                    }
                    svg.style.transform = `scale(${currentScale})`;
                    svg.style.transformOrigin = "center center";
                },
                { passive: false },
            );

            // Run after mermaid renders (fallback for any late-rendered diagrams)
            // But only wrap AFTER mermaid.run() completes
            let mermaidFinished = false;

            // Run after mermaid renders (fallback for any late-rendered diagrams)
            const observer = new MutationObserver(() => {
                if (mermaidFinished) {
                    wrapMermaidDiagrams();
                }
            });

            observer.observe(document.body, {
                childList: true,
                subtree: true,
            });

            // 页面加载后恢复或调整侧边栏滚动位置
            const navTree = document.getElementById("sidebar-nav-tree");
            const activeLink = document.querySelector(".sidebar-link.active");

            if (navTree) {
                // 检查是否有保存的滚动位置（从点击链接时保存）
                const savedScrollTop = sessionStorage.getItem(
                    "sidebar-tree-scroll-top",
                );
                if (savedScrollTop !== null) {
                    // 恢复保存的滚动位置
                    navTree.scrollTo({
                        top: parseInt(savedScrollTop, 10),
                        behavior: "instant",
                    });
                    sessionStorage.removeItem("sidebar-tree-scroll-top");
                } else if (activeLink) {
                    // 没有保存位置时，才自动滚动到选中项（首次访问等场景）
                    setTimeout(() => {
                        const linkRect = activeLink.getBoundingClientRect();
                        const navRect = navTree.getBoundingClientRect();
                        const offset =
                            linkRect.top -
                            navRect.top +
                            navTree.scrollTop -
                            navRect.height / 3;
                        navTree.scrollTo({
                            top: offset,
                            behavior: "instant",
                        });
                    }, 10);
                }

                // 点击目录链接时保存当前滚动位置
                navTree.querySelectorAll(".sidebar-link").forEach((link) => {
                    link.addEventListener("click", () => {
                        sessionStorage.setItem(
                            "sidebar-tree-scroll-top",
                            navTree.scrollTop.toString(),
                        );
                    });
                });
            }

            // Initialize Mermaid via CDN ESM
            const mermaidModule =
                await import("https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs");
            const mermaid = mermaidModule.default;

            // Always use default theme; dark mode is handled by CSS filter
            mermaid.initialize({
                startOnLoad: false,
                theme: "default",
                securityLevel: "loose",
                gantt: {
                    useWidth: 1000, // 设置甘特图最小宽度
                },
            });

            // Manually run mermaid rendering
            try {
                await mermaid.run();
                mermaidFinished = true;
                // After mermaid finishes, wrap diagrams with toolbar.
                // Some diagram types (e.g. stateDiagram-v2) may insert their SVG
                // asynchronously after mermaid.run() resolves, so we poll until
                // all diagrams are wrapped (max 4 seconds).
                wrapMermaidDiagrams();
                let wrapRetries = 0;
                const wrapRetry = setInterval(() => {
                    wrapRetries++;
                    // Check if any unwrapped .mermaid divs still lack an SVG
                    // (mermaid may still be rendering them)
                    const pending = Array.from(
                        document.querySelectorAll("article .mermaid"),
                    ).filter((el) => !el.closest(".mermaid-container"));
                    const allHaveSvg = pending.every((el) =>
                        el.querySelector("svg"),
                    );
                    if (pending.length === 0 || allHaveSvg || wrapRetries >= 20) {
                        // Final wrap attempt for any that now have SVGs
                        if (pending.length > 0) wrapMermaidDiagrams();
                        clearInterval(wrapRetry);
                    } else {
                        wrapMermaidDiagrams();
                    }
                }, 200);
            } catch (e) {
                console.error("Mermaid run error:", e);
            }

            // ========== Navigation Toggle Logic ==========
            const navTreeBtn = document.getElementById("navTreeBtn");
            const navArticleBtn = document.getElementById("navArticleBtn");
            const sidebarNavTree = document.getElementById("sidebar-nav-tree");
            const sidebarNavArticle = document.getElementById(
                "sidebar-nav-article",
            );
            const articleToc = document.getElementById("article-toc");
            const articleContent = document.getElementById("article-content");

            // Priority badges: wrap P0/P1/P2 in priority column with colored spans
            function processPriorityBadges() {
                var tables = document.querySelectorAll("table");
                tables.forEach(function (table) {
                    var headers = table.querySelectorAll("th");
                    var priorityIndex = -1;
                    headers.forEach(function (th, idx) {
                        if ((th.textContent || "").trim() === "优先级") {
                            priorityIndex = idx;
                        }
                    });
                    if (priorityIndex === -1) return;

                    var rows = table.querySelectorAll("tbody tr");
                    rows.forEach(function (row) {
                        var cells = row.querySelectorAll("td");
                        if (cells.length <= priorityIndex) return;
                        var cell = cells[priorityIndex];
                        var text = (cell.textContent || "").trim();
                        var match = text.match(/^([Pp][0-2])$/);
                        if (match) {
                            var level = match[1].toLowerCase();
                            var span = document.createElement("span");
                            span.className = "priority-badge " + level;
                            span.textContent = text;
                            cell.textContent = "";
                            cell.appendChild(span);
                        }
                    });
                });
            }

            // Generate article TOC
            function generateArticleToc() {
                if (!articleContent || !articleToc) return;

                // 获取文档名称（页面标题）
                const pageTitle = document.querySelector("main h1");
                const pageTitleText = pageTitle?.textContent || "";

                const headings =
                    articleContent.querySelectorAll("h1, h2, h3, h4");

                let tocHtml = "";

                // 如果有页面标题，先添加文档名称作为一级
                if (pageTitleText) {
                    tocHtml += `<a class="article-toc-item article-toc-title" data-level="1" data-id="top" href="#">${pageTitleText}</a>`;
                }

                headings.forEach((heading, index) => {
                    const level = parseInt(heading.tagName.replace("H", ""));
                    const text = heading.textContent || "";
                    const id = heading.id || `heading-${index}`;

                    // Ensure heading has an id for anchor link
                    if (!heading.id) {
                        heading.id = id;
                    }

                    tocHtml += `<a class="article-toc-item" data-level="${level}" data-id="${id}" href="#${id}">${text}</a>`;
                });

                if (tocHtml === "") {
                    articleToc.innerHTML =
                        '<div class="text-gray-400 text-sm py-2">暂无目录</div>';
                    return;
                }

                articleToc.innerHTML = tocHtml;

                // Add click handlers for TOC items
                articleToc
                    .querySelectorAll(".article-toc-item")
                    .forEach((item) => {
                        item.addEventListener("click", (e) => {
                            e.preventDefault();
                            const targetId = item.dataset.id;
                            if (targetId === "top") {
                                // 滚动到页面顶部
                                window.scrollTo({
                                    top: 0,
                                    behavior: "smooth",
                                });
                            } else {
                                const targetEl =
                                    document.getElementById(targetId);
                                if (targetEl) {
                                    targetEl.scrollIntoView({
                                        behavior: "smooth",
                                        block: "start",
                                    });
                                }
                            }
                        });
                    });
            }

            // Toggle navigation mode
            function showNavTree() {
                sidebarNavTree?.classList.remove("hidden");
                sidebarNavArticle?.classList.add("hidden");
                navTreeBtn?.classList.add("bg-indigo-100", "text-indigo-600");
                navTreeBtn?.classList.remove("text-gray-400");
                navArticleBtn?.classList.remove(
                    "bg-indigo-100",
                    "text-indigo-600",
                );
                navArticleBtn?.classList.add("text-gray-400");
            }

            function showNavArticle() {
                sidebarNavTree?.classList.add("hidden");
                sidebarNavArticle?.classList.remove("hidden");
                navArticleBtn?.classList.add(
                    "bg-indigo-100",
                    "text-indigo-600",
                );
                navArticleBtn?.classList.remove("text-gray-400");
                navTreeBtn?.classList.remove(
                    "bg-indigo-100",
                    "text-indigo-600",
                );
                navTreeBtn?.classList.add("text-gray-400");
                generateArticleToc();
                updateActiveTocItem();
            }

            // Toggle button handlers
            navTreeBtn?.addEventListener("click", showNavTree);
            navArticleBtn?.addEventListener("click", showNavArticle);

            // Scroll spy - highlight current section
            function updateActiveTocItem() {
                if (!articleContent || !articleToc) return;

                const tocItems =
                    articleToc.querySelectorAll(".article-toc-item");
                const headings =
                    articleContent.querySelectorAll("h1, h2, h3, h4");

                if (tocItems.length === 0) return;

                let activeId = "";
                const headerOffset = 75;
                const scrollTop = window.scrollY;

                // Find the heading that's currently in view
                headings.forEach((heading) => {
                    const rect = heading.getBoundingClientRect();
                    if (rect.top <= headerOffset + 50) {
                        activeId = heading.id;
                    }
                });

                // Update active state (exclude title item)
                tocItems.forEach((item) => {
                    if (item.classList.contains("article-toc-title")) {
                        return; // 文档标题不参与选中
                    }
                    if (item.dataset.id === activeId) {
                        item.classList.add("active");
                    } else {
                        item.classList.remove("active");
                    }
                });
            }

            // Listen to scroll events
            let scrollTicking = false;
            window.addEventListener("scroll", () => {
                if (!scrollTicking) {
                    window.requestAnimationFrame(() => {
                        updateActiveTocItem();
                        scrollTicking = false;
                    });
                    scrollTicking = true;
                }
            });

            // Initial setup
            generateArticleToc();
            processPriorityBadges();

            // ========== Settings Modal ==========
            const settingsModal = document.getElementById("settingsModal");
            const settingsBody = document.getElementById("settingsBody");
            let settingsEditingOldName = null;

            function openSettings() {
                settingsModal?.classList.add("open");
                loadAndRenderSettings();
            }

            function closeSettings() {
                settingsModal?.classList.remove("open");
            }

            document.getElementById("settingsBtn")?.addEventListener("click", openSettings);
            document.getElementById("settingsModalClose")?.addEventListener("click", closeSettings);
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && settingsModal?.classList.contains("open")) {
                    closeSettings();
                }
            });

            async function loadAndRenderSettings() {
                try {
                    const res = await fetch("/api/settings");
                    if (!res.ok) throw new Error("API 不可用");
                    const settings = await res.json();
                    renderSettings(settings);
                } catch (e) {
                    settingsBody!.innerHTML = `
                        <div class="settings-ssr-notice">
                            <strong>提示：</strong>动态管理文档路径需要 SSR 模式。<br>
                            请使用 <code>pnpm dev:ssr</code> 启动。
                        </div>`;
                }
            }

            function renderSettings(settings) {
                const { docsPaths, defaultDoc } = settings;
                let html = docsPaths.map((p, i) => {
                    const isDefault = p.name === defaultDoc;
                    const pathExists = p.exists !== false; // 默认 true（兼容旧数据）
                    const pathMissingClass = !pathExists ? "path-missing" : "";
                    const missingWarning = !pathExists ? '<span class="settings-badge" style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;margin-left:6px;">路径不存在</span>' : "";

                    return `
                    <div class="settings-path-item ${isDefault ? "is-default" : ""} ${pathMissingClass}">
                        <div class="settings-path-info">
                            <div class="settings-path-name">
                                ${p.name}
                                ${isDefault ? '<span class="settings-badge-default">默认</span>' : ""}
                                ${p.preset ? '<span class="settings-badge" style="background:#f0fdf4;color:#16a34a;">预置</span>' : ""}
                                ${missingWarning}
                            </div>
                            <div class="settings-path-dir ${!pathExists ? "path-missing-text" : ""}" title="${p.path}">${p.preset ? (p.description !== "系统预置文档" ? p.description : "点击右侧按钮设置描述") : p.path}</div>
                        </div>
                        <div class="settings-path-actions">
                            ${p.name !== defaultDoc ? `<button class="settings-btn-default" data-action="setDefault" data-name="${p.name}">设为默认</button>` : ""}
                            ${p.preset ? `
                                <button class="settings-btn-edit" data-action="editPresetDesc" data-name="${p.name}" data-desc="${p.description || ""}">设置描述</button>
                                ${p.presetSource === "data" ? `<button class="settings-btn-delete" data-action="deletePreset" data-name="${p.name}">删除</button>` : ""}
                            ` : `
                                <button class="settings-btn-copy" data-action="copy" data-name="${p.name}" title="复制到系统内">复制</button>
                                <button class="settings-btn-edit" data-action="edit" data-index="${i}">编辑</button>
                                <button class="settings-btn-delete" data-action="delete" data-name="${p.name}">删除</button>
                            `}
                        </div>
                    </div>
                `;
                }).join("");

                html += `<button class="settings-add-btn" id="settingsAddBtn">+ 添加文档路径</button>`;
                html += `<div id="settingsFormArea"></div>`;
                settingsBody!.innerHTML = html;

                // Bind events
                document.getElementById("settingsAddBtn")?.addEventListener("click", () => {
                    settingsEditingOldName = null;
                    showSettingsForm("添加文档路径", "", "", "");
                });

                settingsBody!.querySelectorAll("[data-action]").forEach((btn) => {
                    btn.addEventListener("click", async () => {
                        const action = (btn as HTMLElement).dataset.action;
                        const name = (btn as HTMLElement).dataset.name;
                        const index = (btn as HTMLElement).dataset.index;

                        if (action === "setDefault") {
                            await settingsApiPost({ action: "setDefault", name });
                            setTimeout(() => { window.location.href = "/"; }, 300);
                        } else if (action === "edit") {
                            const p = settings.docsPaths[parseInt(index!)];
                            settingsEditingOldName = p.name;
                            showSettingsForm("编辑文档路径", p.name, p.path, p.description);
                        } else if (action === "editPresetDesc") {
                            const desc = (btn as HTMLElement).dataset.desc || "";
                            showPresetDescForm(name!, desc);
                        } else if (action === "delete") {
                            if (confirm(`确定删除 "${name}" 吗？`)) {
                                await settingsApiDelete(name!);
                            }
                        } else if (action === "deletePreset") {
                            // 预置路径删除需要输入名称确认
                            const confirmName = prompt(
                                `⚠️ 删除预置文档将永久删除整个文件夹。\n\n请输入 "${name}" 确认删除：`,
                            );
                            if (confirmName === name) {
                                try {
                                    await settingsApiDelete(name!);
                                    setTimeout(() => { window.location.reload(); }, 300);
                                } catch (e) {
                                    alert((e as Error).message);
                                }
                            } else if (confirmName !== null) {
                                alert("输入的名称不匹配，已取消删除。");
                            }
                        } else if (action === "copy") {
                            if (confirm(`将 "${name}" 的文档复制到系统内（src/content/docs/${name}）？\n复制后可直接删除外部路径。`)) {
                                try {
                                    await settingsApiPost({ action: "copy", name });
                                    setTimeout(() => { window.location.href = "/"; }, 300);
                                } catch (e) {
                                    alert((e as Error).message);
                                }
                            }
                        }
                    });
                });
            }

            function showSettingsForm(title, name, path, desc) {
                const area = document.getElementById("settingsFormArea");
                if (!area) return;
                area.innerHTML = `
                    <div class="settings-form">
                        <h3>${title}</h3>
                        <label>路径</label>
                        <input id="sf-path" value="${path}" placeholder="例如：/home/user/docs/project-a" />
                        <label>名称</label>
                        <input id="sf-name" value="${name}" placeholder="默认自动提取路径最后一级文件夹名" />
                        <label>描述（可选）</label>
                        <input id="sf-desc" value="${desc}" placeholder="例如：项目A的设计文档" />
                        <div id="sf-error" class="settings-error" style="display:none"></div>
                        <div class="settings-form-actions">
                            <button class="settings-form-cancel" id="sf-cancel">取消</button>
                            <button class="settings-form-save" id="sf-save">保存</button>
                        </div>
                    </div>`;

                // 路径变化时，如果名称为空，自动提取路径最后一级文件夹名
                let nameManuallyEdited = !!name; // 如果初始名称非空，认为已手动编辑过
                const sfPath = document.getElementById("sf-path") as HTMLInputElement;
                const sfName = document.getElementById("sf-name") as HTMLInputElement;

                sfPath?.addEventListener("input", () => {
                    if (!nameManuallyEdited && sfPath.value.trim()) {
                        const trimmedPath = sfPath.value.trim().replace(/[/\\]+$/, "");
                        sfName.value = trimmedPath.split(/[/\\]/).pop() || "";
                    }
                });

                sfName?.addEventListener("input", () => {
                    nameManuallyEdited = true; // 用户手动修改过名称
                });

                document.getElementById("sf-cancel")?.addEventListener("click", () => {
                    area.innerHTML = "";
                    settingsEditingOldName = null;
                });

                document.getElementById("sf-save")?.addEventListener("click", async () => {
                    const n = (document.getElementById("sf-name") as HTMLInputElement).value.trim();
                    const p = (document.getElementById("sf-path") as HTMLInputElement).value.trim();
                    const d = (document.getElementById("sf-desc") as HTMLInputElement).value.trim();
                    const errEl = document.getElementById("sf-error")!;

                    if (!n || !p) {
                        errEl.textContent = "名称和路径不能为空";
                        errEl.style.display = "block";
                        return;
                    }

                    try {
                        if (settingsEditingOldName) {
                            await settingsApiPost({ action: "update", oldName: settingsEditingOldName, name: n, path: p, description: d });
                        } else {
                            await settingsApiPost({ action: "add", name: n, path: p, description: d });
                        }
                        area.innerHTML = "";
                        settingsEditingOldName = null;
                    } catch (e) {
                        errEl.textContent = (e as Error).message;
                        errEl.style.display = "block";
                    }
                });
            }

            function showPresetDescForm(name, currentDesc) {
                const area = document.getElementById("settingsFormArea");
                if (!area) return;
                area.innerHTML = `
                    <div class="settings-form">
                        <h3>设置描述 - ${name}</h3>
                        <label>描述</label>
                        <input id="sf-preset-desc" value="${currentDesc === "系统预置文档" ? "" : currentDesc}" placeholder="例如：YooMdSite 平台说明文档" />
                        <div id="sf-error" class="settings-error" style="display:none"></div>
                        <div class="settings-form-actions">
                            <button class="settings-form-cancel" id="sf-cancel">取消</button>
                            <button class="settings-form-save" id="sf-save">保存</button>
                        </div>
                    </div>`;

                document.getElementById("sf-cancel")?.addEventListener("click", () => {
                    area.innerHTML = "";
                });

                document.getElementById("sf-save")?.addEventListener("click", async () => {
                    const desc = (document.getElementById("sf-preset-desc") as HTMLInputElement).value.trim();
                    try {
                        await settingsApiPost({ action: "setPresetDesc", name, description: desc || "系统预置文档" });
                        area.innerHTML = "";
                        setTimeout(() => window.location.reload(), 300);
                    } catch (e) {
                        const errEl = document.getElementById("sf-error")!;
                        errEl.textContent = (e as Error).message;
                        errEl.style.display = "block";
                    }
                });
            }

            async function settingsApiPost(body) {
                const res = await fetch("/api/settings", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(body),
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error);
                renderSettings(data);
                return data;
            }

            async function settingsApiDelete(name) {
                const res = await fetch("/api/settings", {
                    method: "DELETE",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ name }),
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error);
                renderSettings(data);
                return data;
            }
        </script>
    </body>
</html>
