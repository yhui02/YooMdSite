---
import { getDocTree } from "../lib/docs";
import { getDefaultProject, getSiteName } from "../config";
import { isSSRMode, getActiveProject } from "../lib/config-store";

// 获取 base 路径，用于 GitHub Pages 部署
// Astro 默认 BASE_URL 是 "/"，需要特殊处理
const baseUrl = import.meta.env.BASE_URL;
const hasCustomBase = baseUrl && baseUrl !== "/";

// 辅助函数：拼接路径
function withBase(path: string): string {
    const cleanPath = path.startsWith("/") ? path.slice(1) : path;
    if (!hasCustomBase) return `/${cleanPath}`;
    return `${baseUrl}/${cleanPath}`;
}

interface Props {
    title?: string;
    currentPath?: string;
    lastModified?: string;
    tocMode?: "tree" | "article"; // tree: 文档树导航, article: 文章目录
    hideSidebar?: boolean; // 隐藏左侧目录树
}

interface DocTreeNode {
    name: string;
    path?: string;
    children: DocTreeNode[];
    isFile: boolean;
}

const {
    title = "首页",
    currentPath = "",
    lastModified = "",
    tocMode = "tree",
    hideSidebar = false,
} = Astro.props as Props;
const docTree = await getDocTree();
const project = isSSRMode() ? getActiveProject() : getDefaultProject();
const siteName = getSiteName();

// 统计目录和文档数量
function countTree(tree: any[]): { dirs: number; docs: number } {
    let dirs = 0;
    let docs = 0;
    for (const node of tree) {
        if (node.isFile) {
            docs++;
        } else {
            dirs++;
            const sub = countTree(node.children);
            dirs += sub.dirs;
            docs += sub.docs;
        }
    }
    return { dirs, docs };
}

const { dirs: totalDirs, docs: totalDocs } = countTree(docTree);

function renderTreeNode(node: DocTreeNode, depth: number = 0): string {
    if (node.isFile && node.path) {
        const indent = `${12 + depth * 16}px`;
        const isActive = `/docs/${node.path}` === currentPath ? " active" : "";
        // JS 模板字符串需要完整路径（带前导 /）
        const href = hasCustomBase
            ? `${baseUrl}/docs/${node.path}`
            : `/docs/${node.path}`;
        return `<a href="${href}" class="sidebar-link${isActive}" style="padding-left:${indent}">${node.name}</a>`;
    }

    if (node.children.length > 0) {
        const hasFiles = node.children.some((c) => c.isFile);
        const hasSubdirs = node.children.some((c) => !c.isFile);
        const isTopLevel = depth === 0;

        let titleHtml = "";
        if (isTopLevel) {
            titleHtml = `<span class="sidebar-group-title">${node.name}</span>`;
        } else if (hasFiles || hasSubdirs) {
            titleHtml = `<span class="sidebar-subtitle" style="padding-left:${12 + depth * 16}px">${node.name}</span>`;
        }

        const childrenHtml = node.children
            .map((child) => renderTreeNode(child, depth + 1))
            .join("");

        return titleHtml + childrenHtml;
    }

    // 空目录也显示
    const isTopLevel = depth === 0;
    if (isTopLevel) {
        return `<span class="sidebar-group-title">${node.name}<span class="text-gray-400 text-xs ml-1">(空)</span></span>`;
    }
    return `<span class="sidebar-subtitle" style="padding-left:${12 + depth * 16}px">${node.name}<span class="text-gray-400 text-xs ml-1">(空)</span></span>`;
}
